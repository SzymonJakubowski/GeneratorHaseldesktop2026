<Window x:Class="GeneratorHasełdesktop2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeneratorHasełdesktop2026"
        mc:Ignorable="d"
        Title="Generator i Walidator Bezpiecznych Haseł Autor:12345678901" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">



        <StackPanel Orientation="Horizontal">

            <StackPanel Width="350"
                        Margin="0,0,20,0">

                <TextBlock Text="Ile znaków?"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtIloscZnakow"
                         Width="200"
                         Height="30"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,20"/>

                <CheckBox x:Name="WielkieLitery"
                          Content="Wielkie litery"
                          FontSize="15"
                          Margin="0,0,0,8"/>

                <CheckBox x:Name="Cyfry"
                          Content="Cyfry"
                          FontSize="15"
                          Margin="0,0,0,8"/>

                <CheckBox x:Name="ZnakiSpecjalne"
                          Content="Znaki specjalne"
                          FontSize="15"/>
            </StackPanel>

            <StackPanel Width="350">

                <Button x:Name="btnGeneruj"
            Content="GENERUJ HASŁO"
            Width="300"
            Height="45"
            HorizontalAlignment="Center"
            Background="DodgerBlue"
            Foreground="White"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

                <TextBox x:Name="txtHaslo"
             Width="300"
             Height="35"
             IsReadOnly="True"
             HorizontalAlignment="Center"
             Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,5">

                    <TextBlock Text="Siła hasła: "
               FontSize="16"
               VerticalAlignment="Center"/>

                    <TextBlock x:Name="txtSilaHasla"
                     Margin="200,0,0,0"
               Text="—"
               FontSize="20"
               FontWeight="Bold"
               Foreground="Gray"
               VerticalAlignment="Center"/>

                </StackPanel>

            </StackPanel>

        </StackPanel>

        <StackPanel Margin="0,30,0,0">

            <TextBlock Text="Historia haseł"
                       FontSize="18"
                       Margin="0,0,0,10"/>

            <ListBox x:Name="lstHistoria"
                     Height="180"
                     HorizontalContentAlignment="Stretch"/>
        </StackPanel>

    </StackPanel>


</Window>
